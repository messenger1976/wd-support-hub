<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteBase /wd-support-hub/
 RewriteRule ^api/push$ api.php?action=push [L,QSA]
 RewriteRule ^api/poll$ api.php?action=poll [L,QSA]
 RewriteRule ^api/board$ api.php?action=board [L,QSA]
 RewriteRule ^api/board-receipts$ api.php?action=board_receipts [L,QSA]
 RewriteRule ^board-assets/([A-Za-z0-9-]+)$ board_asset.php?uuid=$1 [L,QSA]
 RewriteCond %{REQUEST_FILENAME} !-f
 RewriteCond %{REQUEST_FILENAME} !-d
 RewriteRule ^(.*)$ index.php [L]
</IfModule>
