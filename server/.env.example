# Copy to server/.env and edit for this machine. server/.env is never committed or deployed.

PORT=3000
# local | production — local may surface the reset link on screen if mail cannot be sent
APP_ENV=production
# Public URL of the hub (used in password reset emails and notification links)
BASE_URL=https://support-hub.example.com/
# Timezone used for every DATETIME the hub writes (keep identical to the WD apps)
APP_TIMEZONE=Asia/Manila
# Set to 1 (or a hop count) when running behind Apache/Nginx/Passenger so client IPs are correct
TRUST_PROXY=0

# MySQL (same database as the PHP hub)
DB_HOST=localhost
DB_PORT=3306
# Shared hosting: if TCP to localhost is refused, use the MySQL socket instead (overrides host/port)
DB_SOCKET=
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=wd_support_hub

# Sign-in session (long random string; changing it signs everyone out)
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=12

# Attachments (defaults to the repo-level uploads/ folder shared with the PHP hub)
UPLOAD_DIR=
MAX_UPLOAD_KB=4096

# Password reset
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_COOLDOWN_SECONDS=90

# Mail (SMTP). Leave SMTP_HOST empty to disable sending.
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=WD Support Hub
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

# Firebase Cloud Messaging — leave blank to run without push notifications.
# Server credentials: path to the service-account JSON (Project settings → Service accounts),
# or the JSON itself in FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Web app config (Project settings → General → Your apps) — public identifiers, not secrets.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → key pair
FIREBASE_VAPID_KEY=
